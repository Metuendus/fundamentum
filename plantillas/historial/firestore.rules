// Fragmento para el firestore.rules de cada app (Fundamentum 1.4.0).
//
// - `adk/**`: sesiones de ADK (SesionesFirestore). Solo el servidor.
// - `historial/{uid}/**`: historial visible (Historial / PluginHistorial). La persona lee el suyo,
//   en tiempo real, desde cualquier dispositivo. Nadie escribe desde el cliente: el servidor
//   agrega los mensajes y borra conversaciones a pedido (así también borra la sesión de ADK).

match /adk/{documento=**} {
  allow read, write: if false;
}

match /historial/{uid}/{documento=**} {
  allow read: if request.auth != null && request.auth.uid == uid;
  allow write: if false;
}
